{
  "id": "/",
  "name": "Storyframe",
  "short_name": "Storyframe",
  "description": "One library, one reading profile, and one continuous memory across radically different interactive stories.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/#/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F5F1E8",
  "theme_color": "#F5F1E8",
  "categories": ["books", "entertainment", "education"],
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/screenshots/wide-shelf.png", "sizes": "1360x880", "type": "image/png", "form_factor": "wide", "label": "Your shelf, with the book you were reading waiting at the top" },
    { "src": "/screenshots/narrow-shelf.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "The shelf on a phone" },
    { "src": "/screenshots/narrow-reading.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Reading a Quick Book" }
  ],
  "shortcuts": [
    { "name": "Continue reading", "short_name": "Continue", "url": "/#/continue", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Library", "short_name": "Library", "url": "/#/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Offline centre", "short_name": "Offline", "url": "/#/offline", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
